# So that Vim doesn't hang when using Ctrl mappings.
stty -ixon

alias ll='ls -lah'
alias python='/usr/local/bin/python3'

export SHARED_CLOUD_DIR=$HOME/Google\ Drive/Shared

#--------------------------------------------------
# Git aliases
#--------------------------------------------------
alias gs='git status'
alias gl='git log'
alias gb='git branch'
alias gconflicts='git diff --name-only --diff-filter=U'

alias gpu='git pull'

alias gc='git commit'
alias gco='git commit -m '
alias gca='git commit --amend'

alias gd='git diff'
alias gr='git rebase'

alias gch='git checkout'

alias ga='git add'
alias gap='git add -p'

#--------------------------------------------------
# Command overrides
#--------------------------------------------------
alias ag='ag --path-to-ignore $HOME/.ignore'

#--------------------------------------------------
# Docker
#--------------------------------------------------
alias d='docker'
alias di='docker image'
alias dis='docker images'
alias dc='docker-compose'
alias dcd='sudo docker compose down'
alias dcu='sudo docker compose up'
alias dcp='sudo docker compose ps'
alias docker-stop-all='docker container stop $(docker container ls -q)'

#--------------------------------------------------
# Rclone
#--------------------------------------------------
alias rclone-check='rclone --fast-list --transfers 16 --checkers 32 --progress --exclude "**/.rockbox/**" check'
alias rclone-copy='rclone --fast-list --transfers 16 --checkers 32 --progress copy'

alias uuid='python3 -c "import uuid; print(uuid.uuid4())"'

# Platform specific aliases
platform=$(uname -s)
if [[ $platform == "Linux" ]]; then
  alias reboot-machine='shutdown --reboot now'

  if command -v apt &> /dev/null; then
    alias install-package='sudo apt-get install'
    alias update-packages='(sudo apt-get update && sudo apt-get dist-upgrade && sudo apt-get autoclean && sudo apt-get autoremove)'
  fi

  # xclip alises
  if ! type xclip > /dev/null; then
    sudo apt install xclip
  fi
  alias copy='xclip -selection clipboard'
  alias paste='xclip -selection clipboard -o'

  # Networking aliases
  alias print-public-ip='wget -qO- https://ipecho.net/plain ; echo'
fi

alias findproc='ps aux | ag '
alias sysinfo='fastfetch'

alias tmux='tmux -f ~/.tmux.conf'
